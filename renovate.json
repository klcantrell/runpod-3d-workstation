{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "schedule": ["before 9am on monday"],
  "customManagers": [
    {
      "description": "ARG versions in the Dockerfile marked with a '# renovate:' comment",
      "customType": "regex",
      "managerFilePatterns": ["/(^|/)Dockerfile$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)( extractVersion=(?<extractVersion>\\S+))?\\s+ARG \\S+=(?<currentValue>\\S+)"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Base image tags are 26.04-<build timestamp>; treat the timestamp as the version",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/selkies-project/selkies-egl-desktop"],
      "versioning": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)$"
    },
    {
      "description": "Claude Code ships daily; follow its stable channel instead",
      "matchPackageNames": ["@anthropic-ai/claude-code"],
      "followTag": "stable"
    },
    {
      "description": "One PR for all GitHub Actions bumps",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions"
    }
  ]
}
